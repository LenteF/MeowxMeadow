  <Target Name="GenerateMod" AfterTargets="Build">
    <ItemGroup>
      <RemovePlugins Include="$(OutputPath)*.dll" Exclude="$(OutputPath)meowxmeadow.dll" />
	  <RemovePlugins Include="$(OutputPath)*.dll.config" />
      <RemovePlugins Include="$(OutputPath)*.pdb" />
	  <RemovePlugins Include="$(OutputPath)*.xml" />
    </ItemGroup>
    <Delete Files="@(RemovePlugins)" />
  </Target>

